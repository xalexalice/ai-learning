---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import { published } from '../../lib/content';
const tracks = await published('tracks');
---
<Layout title="学习路径">
  <div class="wrap"><header class="page-head"><p class="eyebrow">LEARN IN SEQUENCE</p><h1>学习路径</h1><p>按前置知识组织笔记。每一步都有一个具体任务，完成后用自己的话解释，再向前走。</p></header>
    <div class="cards">{tracks.map((entry, i) => <Card entry={entry} number={i + 1} />)}</div>
    {!tracks.length && <p class="empty-state">学习路径整理中，稍后回来看看。</p>}
  </div>
</Layout>
