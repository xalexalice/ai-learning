---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import Filters from '../../components/Filters.astro';
import { published } from '../../lib/content';
const notes = await published('notes');
---
<Layout title="知识笔记" description="用自己的语言理解 AI 概念，记录可复现的实验和学习复盘。">
  <div class="wrap">
    <header class="page-head"><p class="eyebrow">THE NOTEBOOK</p><h1>知识笔记</h1><p>每篇笔记回答一个问题。保留来源、核验日期和适用边界，把理解与实验一起记录下来。</p></header>
    <Filters mode="notes" />
    <div class="cards">{notes.map(entry => <Card entry={entry} />)}</div>
  </div>
</Layout>
