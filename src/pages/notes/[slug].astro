---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Toc from '../../components/Toc.astro';
import { published } from '../../lib/content';
import { withBase, entryPath } from '../../lib/paths';
import { topics, kinds } from '../../site';
export async function getStaticPaths() {
  return (await published('notes')).map(entry => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const [resources, notes, tracks] = await Promise.all([published('resources'), published('notes'), published('tracks')]);
const sources = resources.filter(resource => data.sources.includes(resource.data.slug));
const prerequisites = notes.filter(note => data.prerequisites.includes(note.data.slug));
const related = notes.filter(note => data.related.includes(note.data.slug));
const backlinks = notes.filter(note => note.data.slug !== data.slug && (note.data.related.includes(data.slug) || note.data.prerequisites.includes(data.slug)));
const inTracks = tracks.filter(track => track.data.steps.some(step => step.note === data.slug));
---
<Layout title={data.title} description={data.summary}>
  <div class="wrap">
    <article data-pagefind-body>
      <header class="article-head">
        <nav class="breadcrumb" aria-label="面包屑" data-pagefind-ignore><a href={withBase()}>首页</a><span>/</span><a href={withBase('notes/')}>知识笔记</a></nav>
        <span class="eyebrow" data-pagefind-filter="类型">{kinds[data.kind]}</span> · <a class="topic-label" data-pagefind-filter="主题" href={withBase(`topics/${data.topic}/`)}>{topics[data.topic]}</a>
        <h1 data-pagefind-meta="title">{data.title}</h1><p class="summary" data-pagefind-meta="description">{data.summary}</p>
        <div class="article-meta"><span>发布 <time datetime={data.publishedAt!}>{data.publishedAt}</time></span><span>更新 <time datetime={data.updatedAt}>{data.updatedAt}</time></span><span>最后核验 <time datetime={data.lastReviewedAt!}>{data.lastReviewedAt}</time></span></div>
        {prerequisites.length > 0 && <div class="callout" data-pagefind-ignore>建议先读：{prerequisites.map((note, i) => <><a href={entryPath('notes', note.data.slug)}>{note.data.title}</a>{i < prerequisites.length - 1 ? '、' : ''}</>)}</div>}
      </header>
      <div class="article-grid"><div class="article-body"><div class="prose"><Content /></div>
        <section class="references" aria-labelledby="sources-title"><h2 id="sources-title">原始资料与核验依据</h2><ul>{sources.map(source => <li><a href={entryPath('resources', source.data.slug)}>{source.data.title}</a><small>{source.data.author} · {source.data.version} · 访问于 {source.data.accessedAt}</small></li>)}</ul></section>
        {related.length > 0 && <section class="article-relations" data-pagefind-ignore><h2>继续探索</h2><ul>{related.map(note => <li><a href={entryPath('notes', note.data.slug)}>{note.data.title}</a></li>)}</ul></section>}
        {backlinks.length > 0 && <section class="article-relations" data-pagefind-ignore><h2>哪些笔记引用了这里</h2><ul>{backlinks.map(note => <li><a href={entryPath('notes', note.data.slug)}>{note.data.title}</a></li>)}</ul></section>}
        {inTracks.map(track => {
          const index = track.data.steps.findIndex(step => step.note === data.slug);
          const prev = track.data.steps[index - 1]; const next = track.data.steps[index + 1];
          return <section class="article-relations" data-pagefind-ignore><h2>学习路径：<a href={entryPath('tracks', track.data.slug)}>{track.data.title}</a></h2><p class="muted">第 {index + 1} / {track.data.steps.length} 步 · 验证任务：{track.data.steps[index].task}</p><nav class="pagination" aria-label={`${track.data.title}章节导航`}>{prev && <a href={entryPath('notes', prev.note)}><small>← 上一步</small>{prev.title}</a>}{next && <a href={entryPath('notes', next.note)}><small>下一步 →</small>{next.title}</a>}</nav></section>;
        })}
      </div><Toc headings={headings} /></div>
    </article>
  </div>
</Layout>
